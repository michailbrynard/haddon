{
  "name": "haddon-site",
  "description": "Documentation site and homepage for Haddon, built from docs/ and the README",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build && node scripts/check-dist.mjs",
    "build:cloudflare": "bash scripts/cloudflare-build.sh",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.7",
    "astro": "^7.4.2",
    "starlight-links-validator": "^0.27.0",
    "starlight-openapi": "^0.27.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
