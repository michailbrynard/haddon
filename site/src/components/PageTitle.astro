---
// Starlight's page title, with a button under it that copies the page as markdown, for handing to an agent.
// Pages without a markdown copy (the API reference) get the title alone. The markdown's address is in the
// page's <link rel="alternate"> (Head.astro) and in llms.txt.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { markdownPath } from '../lib/markdown';
import CopyButton from './CopyButton.astro';

const markdown = markdownPath(Astro.locals.starlightRoute.id);
---

<Default />
{
  markdown && (
    <div class="page-actions" role="group" aria-label="Page actions" data-markdown={markdown}>
      <CopyButton label="Copy page" class="copy-page" />
      <span class="sr-only" role="status" />
    </div>
  )
}

<script>
  import { copyFrom } from '../lib/copy';

  for (const group of document.querySelectorAll<HTMLElement>('.page-actions')) {
    const markdown = new URL(group.dataset.markdown!, location.href).href;
    copyFrom(group.querySelector<HTMLButtonElement>('.copy-page')!, group.querySelector<HTMLElement>('[role="status"]'), () =>
      fetch(markdown).then((r) => {
        if (!r.ok) throw new Error(`${r.status} for ${markdown}`);
        return r.text();
      }),
    );
  }
</script>

<style>
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
  .page-actions :global(button) {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .page-actions :global(button):hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
  .page-actions :global(button) {
    padding: 0;
    border: 0;
    background: none;
  }
  .page-actions :global(button):focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
