---
// Starlight's page title, with a row of actions under it for handing the page to an agent: copy its markdown,
// copy the address of the markdown, open it, or copy a short prompt that points an agent at it. Pages without
// a markdown copy (the API reference) get the title alone. Nothing here names a particular agent or vendor.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { markdownPath } from '../lib/markdown';
import CopyButton from './CopyButton.astro';

const markdown = markdownPath(Astro.locals.starlightRoute.id);
---

<Default />
{
  markdown && (
    <div class="page-actions" role="group" aria-label="Page actions" data-markdown={markdown}>
      <CopyButton label="Copy page" data-copy="page" />
      <CopyButton label="Copy Markdown link" data-copy="link" />
      <a href={markdown} type="text/markdown">View as Markdown</a>
      <CopyButton label="Copy prompt" data-copy="prompt" />
      <span class="sr-only" role="status" />
    </div>
  )
}

<script>
  import { copyFrom } from '../lib/copy';

  for (const group of document.querySelectorAll<HTMLElement>('.page-actions')) {
    // Absolute against wherever the page is served from, so a preview build hands out its own addresses.
    const markdown = new URL(group.dataset.markdown!, location.href).href;
    const llms = new URL('/llms.txt', location.href).href;
    const texts: Record<string, () => string | Promise<string>> = {
      page: () =>
        fetch(markdown).then((r) => {
          if (!r.ok) throw new Error(`${r.status} for ${markdown}`);
          return r.text();
        }),
      link: () => markdown,
      prompt: () => `Read ${markdown} and ${llms}, then help me with Haddon.`,
    };
    const status = group.querySelector<HTMLElement>('[role="status"]');
    for (const button of group.querySelectorAll<HTMLButtonElement>('button[data-copy]'))
      copyFrom(button, status, texts[button.dataset.copy!]);
  }
</script>

<style>
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
  .page-actions a,
  .page-actions :global(button) {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .page-actions a:hover,
  .page-actions :global(button):hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
  .page-actions :global(button) {
    padding: 0;
    border: 0;
    background: none;
  }
  .page-actions a:focus-visible,
  .page-actions :global(button):focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
